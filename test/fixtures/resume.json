0Z","PlayedPercentage":2800},"VideoType":"VideoFile","Overview":"梅长苏、霓凰与赶来的靖王一起呵退了公公。这才知靖王一直私下关照这个叫庭生的罪奴，梅长苏看出庭生的求知欲，主动提出收他为徒，并承诺靖王会想办法救庭生出去。霓凰之弟穆青担心姐姐被梅长苏诱骗，派人探查此人武功虚实，被蒙挚喝退。原来蒙挚曾是林氏麾下一员，这些年一直与梅长苏通信往来，一早认出了梅长苏实为林殊。霓凰在家中训斥穆青鲁莽胡为，穆青不解，霓凰回忆当年大梁与南楚水战，推断是梅长苏帮其破解敌阵。蒙挚深夜来访雪庐，向梅长苏表明忠心要助其成事。梅长苏痛苦回忆，当年梅岭冤案，林氏带领的七万赤焰军全军覆没，魂葬梅岭。梁帝宣旨，由霓凰亲自推举的梅长苏执掌比武选亲的文试部分。此时，比武场上出现了一匹黑马，来自北燕的百里奇，武功奇高。众人慌乱，梁帝害怕霓凰嫁到北燕会令北燕如虎添翼，问誉王、太子有何办法阻止。梁帝设宴宴请进入文试前十名的候选人，萧景睿预设在宴会上与百里奇对战一场，欲拼尽全力伤其锐气。","SeasonId":"9e57c679a3ac4fdaa66506acce6d010b","SeriesId":"15d4f8a1c8fe40c9999581949559c401","SeriesName":"琅琊榜","IndexNumber":3,"ParentIndexNumber":1,"SeriesPrimaryImageTag":"432bcf8646db4e108b9a6904c18c17ef","ParentBackdropItemId":"432bcf8646db4e108b9a6904c18c17ef","ParentBackdropImageTags":["432bcf8646db4e108b9a6904c18c17ef"],"ParentLogoItemId":"432bcf8646db4e108b9a6904c18c17ef","ParentLogoImageTag":"432bcf8646db4e108b9a6904c18c17ef"},{"BackdropImageTags":["71a38cc6487443609e686fdcca16cae8"],"CanDelete":false,"CanDownload":false,"ChannelId":null,"DateCreated":"2026-07-07T07:59:18.0000000Z","Etag":"71a38cc6487443609e686fdcca16cae8","ExternalUrls":null,"GenreItems":[],"Genres":[],"Id":"5d8c289228a14459ac49c9af0a853788","ImageBlurHashes":{"Backdrop":"dUD,K0of5StS?wWXT0x]9Zj]%2j[M|s:nhM{Nxayxuoz","Primary":"WD9%r1.TK7tmo#WXKQyE.9x^tRs;XUtS%Nxvozt7-;t8Rka#WVNG"},"ImageTags":{"Primary":"71a38cc6487443609e686fdcca16cae8","Backdrop":"71a38cc6487443609e686fdcca16cae8"},"IsFolder":false,"LocalTrailerCount":0,"LocationType":"FileSystem","LockData":false,"LockedFields":null,"MediaSources":[{"Id":"71a38cc6487443609e686fdcca16cae8","MediaStreams":[{"AudioSpatialFormat":"","BitRate":0,"Codec":"","CodecTag":"","DisplayTitle":"  ","Index":0,"IsAVC":false,"IsDefault":false,"IsExternal":false,"IsForced":false,"IsHearingImpaired":false,"IsInterlaced":false,"IsTextSubtitleStream":false,"Language":"","Level":0,"Profile":"","SupportsExternalStream":false,"TimeBase":"","Type":"Video","VideoRange":"","VideoRangeType":""}],"Path":"/vol1/d